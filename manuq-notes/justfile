# Recipes to sync the notes in this folder with an rclone remote.
#
# The remote is private, so it's not in this file: each device stores it in
# ~/.config/manuq-notes/remote.
#
# This justfile is installed as a symlink by the mq repository, so it's
# excluded from the sync.

remote-file := home_directory() / ".config/manuq-notes/remote"
remote-destination := if path_exists(remote-file) == "true" { trim(read(remote-file)) } else { error("Write the rclone remote of the notes to " + remote-file) }
# When a file changed on both sides, keep the newer one with its name, so the
# page doesn't disappear from Logseq. The older one is kept as
# <name>.conflict1, to check if anything is missing.
bisync-options := '-v --track-renames --check-access --resilient --exclude=logseq/bak/** --exclude=/justfile --conflict-resolve newer --conflict-loser num'

default:
	@just --list

# Show what a sync would change, without changing anything
test-sync: (bisync "--dry-run")

# Sync this copy with the remote
do-sync: (bisync)

# Run rclone bisync. In a terminal, show a summary and keep rclone's output in
# a log file. Otherwise, like in the systemd service, show rclone's output.
# Set NOTES_SYNC_VERBOSE=1 to see rclone's output in a terminal too.
[private]
bisync *flags:
	#!/usr/bin/bash
	set -euo pipefail
	command=(rclone bisync {{flags}} {{bisync-options}} ./ "{{remote-destination}}")
	if [[ ! -t 1 || -n "${NOTES_SYNC_VERBOSE:-}" ]]; then
		exec "${command[@]}"
	fi
	log="${XDG_CACHE_HOME:-$HOME/.cache}/manuq-notes/last-sync.log"
	mkdir -p "${log%/*}"
	status=0
	"${command[@]}" > "$log" 2>&1 || status=$?
	# The summary script lives next to the real justfile, in the mq repository.
	summarize="$(dirname "$(readlink -f justfile)")/summarize-sync.py"
	python3 "$summarize" "$log" {{flags}} || true
	exit "$status"

# Don't run it in a copy that is already synced: --resync makes this side
# win, so files deleted elsewhere would come back.
# Set up a new copy, in an empty folder that only has this justfile
first-sync:
	touch RCLONE_TEST
	rclone bisync --resync \
	{{bisync-options}} ./ {{remote-destination}}

# Sync this copy automatically: when notes change, and periodically
enable-automatic-sync:
	systemctl --user daemon-reload
	systemctl --user enable --now "manuq-notes-sync@$(systemd-escape --path "{{module_directory()}}").path" "manuq-notes-sync@$(systemd-escape --path "{{module_directory()}}").timer"

# Stop syncing this copy automatically
disable-automatic-sync:
	systemctl --user disable --now "manuq-notes-sync@$(systemd-escape --path "{{module_directory()}}").path" "manuq-notes-sync@$(systemd-escape --path "{{module_directory()}}").timer"
